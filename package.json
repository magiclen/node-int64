{
    "name": "int64-napi",
    "version": "5.0.0",
    "description": "Use Rust to compute 64-bit signed integers.",
    "keywords": [
        "int64",
        "long",
        "nodejs"
    ],
    "homepage": "https://magiclen.org/node-js-int64/",
    "bugs": {
        "url": "https://github.com/magiclen/node-int64/issues"
    },
    "license": "MIT",
    "author": "Magic Len",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/magiclen/node-int64.git"
    },
    "files": [
        "lib",
        "src/**/*.rs",
        "build.rs",
        "Cargo.toml",
        "Cargo.lock"
    ],
    "type": "module",
    "types": "./lib/index.d.ts",
    "exports": "./lib/index.js",
    "scripts": {
        "test": "tsx --test",
        "clean": "rimraf lib native",
        "build": "npm run clean && npm run install && tsc -p tsconfig.build.json",
        "build:watch": "npm run build -- -w",
        "lint": "oxlint",
        "lint:fix": "oxlint --fix",
        "format": "oxfmt",
        "format:check": "oxfmt --check",
        "knip": "knip",
        "check": "npm run lint && npm run format:check && npm run knip",
        "prepare": "node setup-git-hooks.mjs",
        "prepack": "npm run build",
        "prepublishOnly": "npm run check && npm run test",
        "install": "napi build --release --platform --output-dir native --js index.cjs --dts index.d.cts --format commonjs --no-const-enum -- --locked"
    },
    "dependencies": {
        "@napi-rs/cli": "^3.9.1"
    },
    "devDependencies": {
        "@types/node": "^26.5.1",
        "knip": "^6.35.1",
        "oxfmt": "^0.67.0",
        "oxlint": "^1.82.0",
        "oxlint-tsgolint": "^7.0.2001",
        "rimraf": "^6.1.3",
        "tsx": "^4.23.13",
        "typescript": "^7.0.2"
    },
    "engines": {
        "node": ">=24"
    }
}
